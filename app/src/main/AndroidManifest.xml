<!--
  AI use: Claude Opus 5.5 (Anthropic), used through Claude Code, helped add the
  LambdaApplication entry in October 2026. Sashreek Addanki reviewed and committed it.

  The notification permission was added by Aarush Bhat with the assistance
  of Claude Sonnet 5 (Anthropic), through Claude Code, in November 2026.
  Aarush Bhat reviewed and committed it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 and later need this to show any notification, including
         a push (US 01.10.01). MainActivity asks for it at startup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LambdaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LambdaCampsite">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LambdaCampsite"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

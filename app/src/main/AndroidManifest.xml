<?xml version="1.0" encoding="utf-8"?>
<!--
  Purpose: declares the app's activity, its FCM service, the notification
  permission, and the settings Firebase Messaging and Google Maps read.
  Outstanding issues: None known.

  AI use: Claude Opus 5.5 (Anthropic), used through Claude Code, helped add the
  LambdaApplication entry in October 2026. Sashreek Addanki reviewed and committed it.

  The notification permission and the FCM token service registration were
  added by Aarush Bhat with the assistance of Claude Sonnet 5 (Anthropic),
  through Claude Code, in November 2026. Aarush Bhat reviewed and committed
  them.

  Claude Opus 5.5 (Anthropic), used through Claude Code, also helped Sashreek
  Addanki add the default push icon and channel on November 1, 2026. Sashreek
  Addanki reviewed them.

  Claude Opus 5.5 (Anthropic), used through Claude Code, also helped Sashreek
  Addanki add the Google Maps key entry on November 3, 2026. Sashreek Addanki
  reviewed it.
  GPT-6 (OpenAI), through Codex, assisted me with the Flow 16 camera
  permission and optional camera feature declarations. Human review is pending.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 and later need this to show any notification, including
         a push (US 01.10.01). MainActivity asks for it at startup. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".LambdaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LambdaCampsite">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LambdaCampsite"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Saves this device's FCM token on its profile (US 01.10.01). -->
        <service
            android:name=".FcmTokenService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- How FCM shows a push while the app is in the background: a white
             tent in the status bar instead of a blank square, in the channel
             LambdaApplication creates (US 01.10.01). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />

        <!-- The Google Maps key (#98). Gradle fills it in from MAPS_API_KEY in
             local.properties, so the key itself is never committed. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
    </application>

</manifest>
